# Port the app is served on (both host and container side — change this one
# value and it takes effect everywhere: nginx, the healthcheck, and the
# docker-compose port mapping).
PORT=3000

# Copy this to .env and fill in your IPDB API key to enable country-flag lookups.
# Lookups always go through https://avatoris.com (hardcoded — this service can't
# be self-hosted), you only need to provide an API key.
# This database is a free to use service and is not affiliated with the original IPDB project.
# You can get an API key for free at https://avatoris.com. Documentation: https://avatoris.com/api
# Without it, the app still works fine — flags are just skipped.
IPDB_API_KEY=

# Public URL this app is reachable at — used to build Share links.
# Required if you're behind a reverse proxy that terminates TLS (otherwise
# share links would come out as http:// instead of https://). Leave blank to
# fall back to whatever host/protocol the request itself came in on.
APP_URL=https://mha.example.com

# Local Postgres credentials (only reachable from inside the Docker network).
POSTGRES_USER=mha
POSTGRES_PASSWORD=mha
POSTGRES_DB=mha

# Default server-side timezone (container logs, Postgres session display, etc).
# This is just a fallback — times shown in the UI (Received chain, share expiry)
# always use each visitor's own browser timezone regardless of this setting.
TZ=UTC
